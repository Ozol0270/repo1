import sqlite3

DATABASE_NAME = "library.db"

def get_connection():
    return sqlite3.connect(DATABASE_NAME)

def create_tables():
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS books (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        title TEXT NOT NULL,
        author TEXT NOT NULL,
        year INTEGER NOT NULL,
        genre TEXT NOT NULL
    )
    """)

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS readers (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        age INTEGER NOT NULL,
        phone TEXT
    )
    """)

    connection.commit()
    connection.close()


# робота з книгами

def add_book(title, author, year, genre):
    connection = get_connection()
    cursor = connection.cursor()
    cursor.execute(
        "INSERT INTO books (title, author, year, genre) VALUES (?, ?, ?, ?)",
        (title, author, year, genre)
    )
    connection.commit()
    connection.close()


def get_books():
    connection = get_connection()
    cursor = connection.cursor()
    cursor.execute("SELECT id, title, author, year, genre FROM books ORDER BY id")
    books = cursor.fetchall()
    connection.close()
    return books


def get_book(book_id):
    connection = get_connection()
    cursor = connection.cursor()
    cursor.execute(
        "SELECT id, title, author, year, genre FROM books WHERE id = ?",
        (book_id,)
    )
    book = cursor.fetchone()
    connection.close()
    return book


def update_book(book_id, new_title, new_author, new_year, new_genre):
    connection = get_connection()
    cursor = connection.cursor()
    cursor.execute(
        "UPDATE books SET title = ?, author = ?, year = ?, genre = ? WHERE id = ?",
        (new_title, new_author, new_year, new_genre, book_id)
    )
    connection.commit()
    connection.close()


def delete_book(book_id):
    connection = get_connection()
    cursor = connection.cursor()
    cursor.execute("DELETE FROM books WHERE id = ?", (book_id,))
    connection.commit()
    connection.close()


def search_book(title):
    connection = get_connection()
    cursor = connection.cursor()
    cursor.execute(
        "SELECT id, title, author, year, genre FROM books WHERE title LIKE ? ORDER BY title",
        (f"%{title}%",)
    )
    books = cursor.fetchall()
    connection.close()
    return books


